#!/usr/bin/env bash
# hs-session: drive a headless Hyprstack instance for manual / scripted E2E testing.
#
#   hs-session start [--bin PATH] [--config FILE] [--res WxH] [--outputs N] [--vnc PORT]
#   hs-session stop
#   hs-session ctl ARGS...        run hyprctl against the session
#   hs-session spawn CMD...       run a client inside the session (detached)
#   hs-session exec CMD           run a command through the compositor (gets DISPLAY for X11 apps)
#   hs-session shot [FILE]        screenshot all outputs (grim), prints the path
#   hs-session env                print exports to use the session from a shell
#   hs-session log                tail the compositor log
#
# State lives in $HS_STATE_DIR (default: ~/.cache/hs-session).

set -euo pipefail

STATE_DIR="${HS_STATE_DIR:-$HOME/.cache/hs-session}"
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
mkdir -p "$STATE_DIR"

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

die() { echo "hs-session: $*" >&2; exit 1; }

load_env() {
    [[ -f "$STATE_DIR/env" ]] || die "no running session (run: hs-session start)"
    # shellcheck disable=SC1091
    source "$STATE_DIR/env"
}

hctl() {
    local bin="$REPO_ROOT/build/hyprctl/hyprctl"
    [[ -x "$bin" ]] || bin="hyprctl"
    "$bin" "$@"
}

cmd_start() {
    local bin="$REPO_ROOT/build/Hyprland" config="" res="1280x720" outputs=1 vnc=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --bin) bin="$2"; shift 2 ;;
            --config) config="$2"; shift 2 ;;
            --res) res="$2"; shift 2 ;;
            --outputs) outputs="$2"; shift 2 ;;
            --vnc) vnc="$2"; shift 2 ;;
            *) die "unknown option $1" ;;
        esac
    done

    [[ -f "$STATE_DIR/env" ]] && cmd_stop >/dev/null 2>&1 || true

    # Only one compositor can be DRM master of the (single) card at a time; a second
    # instance fails to allocate buffers and ends up with 0x0 outputs. Kill leftovers
    # (e.g. from a crashed hyprtester run).
    if pgrep -x Hyprland >/dev/null; then
        echo "hs-session: killing stray Hyprland instances: $(pgrep -x Hyprland | tr '\n' ' ')" >&2
        pkill -x Hyprland || true
        for _ in $(seq 1 30); do pgrep -x Hyprland >/dev/null || break; sleep 0.1; done
        pkill -9 -x Hyprland || true
    fi
    [[ -x "$bin" ]] || die "compositor binary not found: $bin"

    if [[ -z "$config" ]]; then
        config="$STATE_DIR/session.lua"
        {
            for i in $(seq 1 "$outputs"); do
                echo "hl.monitor({ output = \"HEADLESS-$i\", mode = \"${res}@60\", position = \"auto-right\", scale = \"1\" })"
            done
            echo 'hl.monitor({ output = "", disabled = true })'
            cat "$REPO_ROOT/scripts/e2e/session-base.lua"
        } > "$config"
    fi

    local before
    before="$(ls "$XDG_RUNTIME_DIR/hypr" 2>/dev/null || true)"

    # No logind seat over ssh: the noop libseat backend lets aquamarine open the
    # DRM node directly (user is in the video group), which provides the GBM
    # allocator for the headless outputs. Rendering falls back to llvmpipe.
    LIBSEAT_BACKEND=noop HYPRLAND_HEADLESS_ONLY=1 LANG=en_US.UTF-8 \
        setsid "$bin" --config "$config" > "$STATE_DIR/compositor.log" 2>&1 < /dev/null &
    local pid=$!

    local sig=""
    for _ in $(seq 1 100); do
        kill -0 "$pid" 2>/dev/null || { tail -30 "$STATE_DIR/compositor.log"; die "compositor exited"; }
        sig="$(comm -13 <(echo "$before" | sort) <(ls "$XDG_RUNTIME_DIR/hypr" 2>/dev/null | sort) | head -1)"
        [[ -n "$sig" && -S "$XDG_RUNTIME_DIR/hypr/$sig/.socket.sock" ]] && break
        sleep 0.1
    done
    [[ -n "$sig" ]] || die "compositor socket never appeared"

    export HYPRLAND_INSTANCE_SIGNATURE="$sig"
    for i in $(seq 1 "$outputs"); do
        hctl output create headless "HEADLESS-$i" >/dev/null
    done

    local wl=""
    for _ in $(seq 1 50); do
        wl="$(hctl -j instances 2>/dev/null | jq -r --arg s "$sig" '.[] | select(.instance == $s) | .wl_socket' || true)"
        [[ -n "$wl" && "$wl" != "null" ]] && break
        sleep 0.1
    done

    cat > "$STATE_DIR/env" <<EOF
export XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR"
export HYPRLAND_INSTANCE_SIGNATURE="$sig"
export WAYLAND_DISPLAY="$wl"
export HS_PID="$pid"
export LANG=en_US.UTF-8
unset DISPLAY
EOF

    if [[ -n "$vnc" ]]; then
        WAYLAND_DISPLAY="$wl" setsid wayvnc 127.0.0.1 "$vnc" > "$STATE_DIR/wayvnc.log" 2>&1 < /dev/null &
        echo "export HS_VNC_PID=\"$!\"" >> "$STATE_DIR/env"
    fi

    echo "started pid=$pid sig=$sig wayland=$wl${vnc:+ vnc=127.0.0.1:$vnc}"
}

cmd_stop() {
    load_env
    [[ -n "${HS_VNC_PID:-}" ]] && kill "$HS_VNC_PID" 2>/dev/null || true
    kill "$HS_PID" 2>/dev/null || true
    for _ in $(seq 1 30); do kill -0 "$HS_PID" 2>/dev/null || break; sleep 0.1; done
    kill -9 "$HS_PID" 2>/dev/null || true
    rm -f "$STATE_DIR/env"
    echo "stopped"
}

cmd_shot() {
    load_env
    local out="${1:-$STATE_DIR/shots/$(date +%H%M%S-%N).png}"
    mkdir -p "$(dirname "$out")"
    grim "$out"
    echo "$out"
}

case "${1:-}" in
    start) shift; cmd_start "$@" ;;
    stop) cmd_stop ;;
    ctl) shift; load_env; hctl "$@" ;;
    spawn) shift; load_env; setsid "$@" > "$STATE_DIR/client-$(basename "$1").log" 2>&1 < /dev/null & echo "pid=$!" ;;
    exec) shift; load_env; hctl dispatch "hl.dsp.exec_cmd('$*')" ;;
    shot) shift; cmd_shot "$@" ;;
    env) load_env; cat "$STATE_DIR/env" ;;
    log) load_env; tail -n "${2:-50}" "$STATE_DIR/compositor.log" ;;
    *) sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
