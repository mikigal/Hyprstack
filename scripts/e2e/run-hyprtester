#!/usr/bin/env bash
# Run hyprtester against the local build. Extra args are passed through (e.g. test names).
#   scripts/e2e/run-hyprtester                     # all tests
#   scripts/e2e/run-hyprtester stackMaximizeToggle # selected tests
#   STACK_ONLY=1 scripts/e2e/run-hyprtester        # only the "stack" group
set -uo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
LOG_DIR="${HS_LOG_DIR:-$HOME/.cache/hs-session}"
mkdir -p "$LOG_DIR"

# shellcheck source=lib.sh
source "$REPO_ROOT/scripts/e2e/lib.sh"

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export LANG=en_US.UTF-8
MODE="$(hs_setup_backend)" || exit 1
echo "run-hyprtester: $MODE mode" >&2

# a crashed run can leave a test compositor behind (desktop sessions are never touched)
hs_kill_test_compositors

ARGS=("$@")
if [[ "${STACK_ONLY:-0}" == "1" && ${#ARGS[@]} -eq 0 ]]; then
    mapfile -t ARGS < <(grep -ho 'TEST_CASE([A-Za-z0-9_]*)' "$REPO_ROOT"/hyprtester/src/tests/stack/*.cpp | sed 's/TEST_CASE(\(.*\))/\1/')
fi

cd "$REPO_ROOT/hyprtester" || exit 1
"$REPO_ROOT/build/hyprtester/hyprtester" -b "$REPO_ROOT/build/Hyprland" -p "$REPO_ROOT/hyprtester/plugin/hyprtestplugin.so" "${ARGS[@]}" 2>&1 \
    | grep -av "MESA-EGL: warning" | tee "$LOG_DIR/hyprtester.log"
RC=${PIPESTATUS[0]}

hs_kill_test_compositors
exit "$RC"
